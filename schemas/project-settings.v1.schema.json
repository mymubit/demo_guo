{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "drama-skills://schemas/project-settings.v1",
  "title": "短剧项目设置",
  "type": "object",
  "required": [
    "schema_version",
    "entry_type",
    "episode_count",
    "target_platform",
    "creation_preferences",
    "audit"
  ],
  "properties": {
    "schema_version": {
      "const": "project-settings.v1"
    },
    "project_id": {
      "type": "string"
    },
    "skills_version": {
      "type": "string"
    },
    "skills_git_ref": {
      "type": "string"
    },
    "entry_type": {
      "enum": ["original_track", "story_adapt"]
    },
    "title": {
      "type": "string"
    },
    "core_idea": {
      "type": "string",
      "minLength": 1
    },
    "external_story": {
      "type": "string",
      "minLength": 1
    },
    "adapt_notes": {
      "type": "object",
      "properties": {
        "retained": {"type": "array", "items": {"type": "string"}},
        "enhanced": {"type": "array", "items": {"type": "string"}},
        "rewritten": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "genre_matrix": {
      "type": "object",
      "required": ["emotion", "identity", "conflict", "world"],
      "properties": {
        "emotion": {"type": "string"},
        "identity": {"type": "string"},
        "conflict": {"type": "string"},
        "world": {"type": "string"}
      },
      "additionalProperties": false
    },
    "flavor_tags": {
      "type": "array",
      "maxItems": 5,
      "uniqueItems": true,
      "items": {"type": "string"}
    },
    "preset_theme_code": {
      "type": ["string", "null"]
    },
    "episode_count": {
      "type": "integer",
      "minimum": 1
    },
    "target_platform": {
      "type": "string"
    },
    "reference_dramas": {
      "type": "array",
      "items": {"type": "string"}
    },
    "creation_preferences": {
      "type": "object",
      "required": [
        "batch_episode_max",
        "outline_mode",
        "scoring_preset",
        "compliance_check_mode",
        "enable_delivery"
      ],
      "properties": {
        "batch_episode_max": {"type": "integer", "minimum": 1, "maximum": 5},
        "outline_mode": {"enum": ["full", "structure_only"]},
        "scoring_preset": {"type": "string"},
        "compliance_check_mode": {"enum": ["standard", "values-risk", "full"]},
        "enable_delivery": {"type": "boolean"},
        "delivery_items": {
          "type": "array",
          "uniqueItems": true,
          "items": {"enum": ["storyboard", "visual", "marketing", "interactive"]}
        }
      },
      "additionalProperties": false
    },
    "platform_policy": {
      "type": "object",
      "properties": {
        "policy_version": {"type": ["string", "null"]},
        "policy_source": {"type": ["string", "null"]},
        "verified_at": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "derived": {
      "type": "object",
      "readOnly": true,
      "properties": {
        "matrix_key": {"type": "string"},
        "rule_params_ref": {"type": "string"}
      },
      "additionalProperties": false
    },
    "audit": {
      "type": "object",
      "required": ["revision", "updated_at", "updated_by"],
      "properties": {
        "revision": {"type": "integer", "minimum": 1},
        "created_at": {"type": "string"},
        "updated_at": {"type": "string"},
        "updated_by": {"type": "string"}
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {"properties": {"entry_type": {"const": "story_adapt"}}},
      "then": {"required": ["external_story"]}
    },
    {
      "if": {"properties": {"entry_type": {"const": "original_track"}}},
      "then": {"required": ["core_idea"]}
    }
  ],
  "additionalProperties": false
}

{
  "$id": "drama-skills://schemas/project-settings.v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "entry_type": {
            "const": "story_adapt"
          }
        }
      },
      "then": {
        "required": [
          "external_story"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "entry_type": {
            "const": "original_track"
          }
        }
      },
      "then": {
        "required": [
          "core_idea"
        ]
      }
    }
  ],
  "properties": {
    "adapt_notes": {
      "$ref": "generated/parameters.schema.json#/$defs/adapt_notes"
    },
    "audience_channel": {
      "$ref": "generated/parameters.schema.json#/$defs/audience_channel"
    },
    "audit": {
      "additionalProperties": false,
      "properties": {
        "created_at": {
          "type": "string"
        },
        "revision": {
          "minimum": 1,
          "type": "integer"
        },
        "updated_at": {
          "type": "string"
        },
        "updated_by": {
          "type": "string"
        }
      },
      "required": [
        "revision",
        "updated_at",
        "updated_by"
      ],
      "type": "object"
    },
    "core_idea": {
      "$ref": "generated/parameters.schema.json#/$defs/core_idea"
    },
    "creation_preferences": {
      "additionalProperties": false,
      "properties": {
        "batch_episode_max": {
          "$ref": "generated/parameters.schema.json#/$defs/batch_episode_max"
        },
        "compliance_check_mode": {
          "$ref": "generated/parameters.schema.json#/$defs/check_mode"
        },
        "delivery_items": {
          "$ref": "generated/parameters.schema.json#/$defs/deliverables"
        },
        "enable_delivery": {
          "$ref": "generated/parameters.schema.json#/$defs/enable_delivery"
        },
        "outline_mode": {
          "$ref": "generated/parameters.schema.json#/$defs/outline_mode"
        },
        "scoring_preset": {
          "$ref": "generated/parameters.schema.json#/$defs/scoring_preset"
        }
      },
      "required": [
        "batch_episode_max",
        "outline_mode",
        "scoring_preset",
        "compliance_check_mode",
        "enable_delivery"
      ],
      "type": "object"
    },
    "derived": {
      "additionalProperties": false,
      "properties": {
        "matrix_key": {
          "type": "string"
        },
        "rule_params_ref": {
          "type": "string"
        }
      },
      "readOnly": true,
      "type": "object"
    },
    "entry_type": {
      "$ref": "generated/parameters.schema.json#/$defs/entry_type"
    },
    "episode_count": {
      "$ref": "generated/parameters.schema.json#/$defs/episode_count"
    },
    "external_story": {
      "$ref": "generated/parameters.schema.json#/$defs/external_story"
    },
    "flavor_tags": {
      "$ref": "generated/parameters.schema.json#/$defs/flavor_tags"
    },
    "genre_matrix": {
      "$ref": "generated/parameters.schema.json#/$defs/genre_matrix"
    },
    "platform_policy": {
      "additionalProperties": false,
      "properties": {
        "policy_source": {
          "type": [
            "string",
            "null"
          ]
        },
        "policy_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "verified_at": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "preset_theme_code": {
      "$ref": "generated/parameters.schema.json#/$defs/preset_theme_code"
    },
    "production_context": {
      "additionalProperties": false,
      "properties": {
        "currency": {
          "$ref": "generated/parameters.schema.json#/$defs/budget_currency"
        },
        "excluded_items": {
          "$ref": "generated/parameters.schema.json#/$defs/budget_excluded_items"
        },
        "pricing_version": {
          "$ref": "generated/parameters.schema.json#/$defs/pricing_version"
        },
        "region": {
          "$ref": "generated/parameters.schema.json#/$defs/production_region"
        },
        "target_band": {
          "$ref": "generated/parameters.schema.json#/$defs/production_target_band"
        }
      },
      "required": [
        "target_band"
      ],
      "type": "object"
    },
    "project_id": {
      "type": "string"
    },
    "protagonist_structure": {
      "$ref": "generated/parameters.schema.json#/$defs/protagonist_structure"
    },
    "reference_dramas": {
      "$ref": "generated/parameters.schema.json#/$defs/reference_dramas"
    },
    "schema_version": {
      "const": "project-settings.v1"
    },
    "skills_git_ref": {
      "type": "string"
    },
    "skills_version": {
      "type": "string"
    },
    "synopsis": {
      "$ref": "generated/parameters.schema.json#/$defs/synopsis"
    },
    "target_platform": {
      "$ref": "generated/parameters.schema.json#/$defs/target_platform"
    },
    "title": {
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "entry_type",
    "episode_count",
    "target_platform",
    "production_context",
    "creation_preferences",
    "audit"
  ],
  "title": "短剧项目设置",
  "type": "object"
}

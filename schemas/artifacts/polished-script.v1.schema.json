{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "drama-skills://artifacts/polished-script.v1",
  "type": "object",
  "required": ["episodes", "revision_summary", "resolved_issues", "remaining_issues"],
  "properties": {
    "episodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["episode_number", "script", "word_count", "dialogue_ratio", "scene_count", "memory_checkpoint", "production_notes"],
        "properties": {
          "episode_number": {"type": "integer", "minimum": 1},
          "title": {"type": "string"},
          "script": {"type": "string", "minLength": 1},
          "word_count": {"type": "integer", "minimum": 1},
          "dialogue_ratio": {"type": "number", "minimum": 0, "maximum": 1},
          "scene_count": {"type": "integer", "minimum": 1},
          "memory_checkpoint": {"$ref": "memory-checkpoint.v1.schema.json"},
          "production_notes": {"type": "object"}
        },
        "additionalProperties": false
      }
    },
    "revision_summary": {"type": "array", "items": {"type": "object"}},
    "resolved_issues": {"type": "array", "items": {"type": "string"}},
    "remaining_issues": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "drama-skills://artifacts/memory-checkpoint.v1",
  "type": "object",
  "required": ["episode", "character_states", "active_clues", "foreshadowing", "rhythm_state", "next_episode_constraints"],
  "properties": {
    "episode": {"type": "integer", "minimum": 1},
    "character_states": {"type": "array", "items": {"type": "object"}},
    "active_clues": {"type": "array", "items": {"type": "object"}},
    "foreshadowing": {"type": "array", "items": {"type": "object"}},
    "relationship_changes": {"type": "array", "items": {"type": "object"}},
    "prop_states": {"type": "array", "items": {"type": "object"}},
    "rhythm_state": {
      "type": "object",
      "required": ["plot_pace", "emotion_pace", "episode_ev"],
      "properties": {
        "plot_pace": {"enum": ["loose", "medium", "tight"]},
        "emotion_pace": {"enum": ["light", "medium", "heavy"]},
        "episode_ev": {"type": "integer", "minimum": 1, "maximum": 10},
        "episode_et": {"type": "integer", "minimum": 1, "maximum": 10},
        "episode_tp": {"type": "string"}
      },
      "additionalProperties": false
    },
    "next_episode_constraints": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}

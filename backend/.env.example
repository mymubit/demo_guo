# 环境变量配置示例
# 复制为 backend/.env 并修改
#
# Windows 本地开发（推荐）：
#   1. 根目录：npm run docker:infra
#   2. 使用下方「本机连接」的 DB_HOST / REDIS 配置
#   3. npm run dev:setup && npm run dev

# Django
SECRET_KEY=your-secret-key-change-in-production
DEBUG=True
ALLOWED_HOSTS=*

# 数据库（本机连接 Docker 中的 Postgres）
DB_NAME=scriptforge
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# Redis（缓存/会话；密码与 docker-compose.yml 中 requirepass 一致）
REDIS_URL=redis://:redis_password_2024@127.0.0.1:6379/1
CACHE_URL=redis://:redis_password_2024@127.0.0.1:6379/2

# dj_queue（Django 6 @task，Postgres 队列；worker 由 npm run dev:worker 启动）
DJ_QUEUE_MODE=async
DJ_QUEUE_WORKER_THREADS=2
# Windows 默认 false；Linux 生产可设 true
DJ_QUEUE_LISTEN_NOTIFY=false
# 独立 Agent 架构下提交接口只创建项目，不再同步或异步跑流水线。

# API 签名密钥（核心安全，务必修改）
API_SIGN_SECRET=change-this-sign-secret-to-a-long-random-string

# 技能加密密钥（32位AES密钥，务必修改）
SKILL_ENCRYPT_KEY=change-this-32-byte-encrypt-key-here

# Agent / Knowledge / Prompt 均以数据库为准；外部资产仅允许一次性导入。
FUSION_SKILL_ENABLED=false
FUSION_ORCHESTRATOR_ENABLED=false
# 节点 2–5 强制 LLM（无 stub 回退）
FUSION_LLM_ENABLED=true
FUSION_LLM_EPISODE_BATCH=5
FUSION_LLM_OUTLINE_BATCH=10
FUSION_LLM_MAX_EPISODES=0
FUSION_SCHEMA_STRICT=false
FUSION_EPISODE_GATE_ENABLED=true

# LLM 配置（加密存储在 SkillConfig；也可在此填写后保存，或 .env 初始化）
# LLM_API_ENDPOINT 可为完整 URL（含 /chat/completions），init_skill_data 会自动规范化
LLM_API_ENDPOINT=https://api.openai.com/v1/chat/completions
LLM_API_KEY=sk-your-api-key-here

# 火山方舟（setup_volcano_agent_llm / 后台「从环境变量一键接入」）
# VOLCANO_ARK_KEY_TYPE=payg          # 按量付费（ep-xxx，推荐）
# VOLCANO_ARK_KEY_TYPE=coding_plan   # 仅 Coding Plan / Agent Plan 订阅 Key
VOLCANO_ARK_API_KEY=
VOLCANO_ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
VOLCANO_ARK_CODING_BASE_URL=https://ark.cn-beijing.volces.com/api/coding/v3
# 可选：推理接入点 ep-xxx（未设置则用目录 Model ID）
# VOLCANO_EP_DEEPSEEK_V4_FLASH=ep-xxxxxxxx
# VOLCANO_EP_DEEPSEEK_V4_PRO=ep-xxxxxxxx
# VOLCANO_EP_DOUBAO_LITE=ep-xxxxxxxx
# VOLCANO_EP_DOUBAO_PRO=ep-xxxxxxxx

# 智谱 GLM-5（Script 节点原生 API）
ZHIPU_API_KEY=
ZHIPU_GLM5_MODEL=glm-5

# JWT 配置
JWT_ACCESS_TTL=3600
JWT_REFRESH_TTL=86400

# 安全配置
ENCRYPT_PHONE_KEY=change-this-phone-encrypt-key
ENCRYPT_EMAIL_KEY=change-this-email-encrypt-key

# 支付配置
WECHAT_PAY_APPID=your-wechat-appid
WECHAT_PAY_MCH_ID=your-mch-id
WECHAT_PAY_API_KEY=your-api-key
WECHAT_PAY_CERT_PATH=/path/to/cert.pem
WECHAT_PAY_KEY_PATH=/path/to/key.pem

ALIPAY_APPID=your-alipay-appid
ALIPAY_PRIVATE_KEY=/path/to/private-key.pem
ALIPAY_PUBLIC_KEY=/path/to/alipay-public-key.pem

# 文件存储
STORAGE_BACKEND=local
STORAGE_BUCKET=scriptforge
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# 日志
LOG_LEVEL=INFO

# 自研业务监控
MONITORING_ENABLED=true
MONITORING_SAMPLE_RATE=1
MONITORING_SLOW_API_MS=1000
MONITORING_SLOW_SQL_MS=500
MONITORING_RETENTION_DAYS=30
MONITORING_MAX_BATCH_SIZE=50
MONITORING_MAX_PAYLOAD_SIZE=16384
MONITORING_ANON_RATE=300/min
MONITORING_USER_RATE=600/min
MONITORING_CAPTURE_RESPONSE=false
MONITORING_LOG_LEVEL=INFO

# 环境变量配置示例
# 复制为 .env 并修改

# Django
SECRET_KEY=your-secret-key-change-in-production
DEBUG=True
ALLOWED_HOSTS=*

# 数据库
DB_NAME=scriptforge
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=db
DB_PORT=5432

# Redis
REDIS_URL=redis://redis:6379/1
CACHE_URL=redis://redis:6379/2

# API 签名密钥（核心安全，务必修改）
API_SIGN_SECRET=change-this-sign-secret-to-a-long-random-string

# 技能加密密钥（32位AES密钥，务必修改）
SKILL_ENCRYPT_KEY=change-this-32-byte-encrypt-key-here

# LLM 配置（加密存储在数据库中，这里仅初始化用）
LLM_API_ENDPOINT=https://api.example.com/v1/chat/completions
LLM_API_KEY=sk-your-api-key-here

# JWT 配置
JWT_ACCESS_TTL=3600
JWT_REFRESH_TTL=86400

# 安全配置
ENCRYPT_PHONE_KEY=change-this-phone-encrypt-key
ENCRYPT_EMAIL_KEY=change-this-email-encrypt-key

# 支付配置
WECHAT_PAY_APPID=your-wechat-appid
WECHAT_PAY_MCH_ID=your-mch-id
WECHAT_PAY_API_KEY=your-api-key
WECHAT_PAY_CERT_PATH=/path/to/cert.pem
WECHAT_PAY_KEY_PATH=/path/to/key.pem

ALIPAY_APPID=your-alipay-appid
ALIPAY_PRIVATE_KEY=/path/to/private-key.pem
ALIPAY_PUBLIC_KEY=/path/to/alipay-public-key.pem

# 文件存储
STORAGE_BACKEND=local
STORAGE_BUCKET=scriptforge
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# 日志
LOG_LEVEL=INFO

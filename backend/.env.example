SECRET_KEY=dev-only-change-me
DEBUG=true
DJANGO_ENV=development
ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL（本机或 docker compose 映射到 localhost）
DB_NAME=scriptforge
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=127.0.0.1
DB_PORT=5432

# Redis / Celery
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/1
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/2

# JWT
JWT_ACCESS_TTL=3600
JWT_REFRESH_TTL=86400

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173

# 技能仓根目录：本地一键脚本会写成仓库绝对路径；此处为相对仓库根的默认
DRAMA_SKILLS_ROOT=../drama-skills

# LLM（本地默认关闭；联调时改为 true 并填密钥）
LLM_ENABLED=false
LLM_API_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# 读超时秒数（选题定调等长输出建议 ≥240；默认 300）
# 长输出：读超时=相邻流式包间隔；SSE 等待需 ≥ 读超时（默认后端会自动 +180s）
# LLM_READ_TIMEOUT=600
# GENERATION_SSE_MAX_WAIT_SECONDS=780
# LLM_CONNECT_TIMEOUT=30

# 可选：不启 Celery worker 时设为 true（./scripts/dev-local.sh --eager）
# CELERY_TASK_ALWAYS_EAGER=true

# 测试专用（可选）
TEST_DB_NAME=scriptforge_test
TEST_REDIS_URL=redis://127.0.0.1:6379/15

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "drama-skills-v6://artifacts/components/episode-scripts",
  "type": "object",
  "required": ["schema_version", "artifact_version", "based_on", "episode_range", "episodes"],
  "properties": {
    "schema_version": {"const": 1},
    "artifact_version": {"type": "integer", "minimum": 1},
    "source_call_id": {"type": "string", "minLength": 1},
    "based_on": {
      "type": "object",
      "required": ["story_bible", "episode_plan"],
      "properties": {
        "story_bible": {"type": "integer", "minimum": 1},
        "episode_plan": {"type": "integer", "minimum": 1},
        "prior_memory_checkpoint": {"type": ["integer", "null"], "minimum": 1}
      },
      "additionalProperties": false
    },
    "episode_range": {
      "type": "object",
      "required": ["start", "count"],
      "properties": {
        "start": {"type": "integer", "minimum": 1},
        "count": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": false
    },
    "episodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["episode_number", "title", "script", "word_count", "dialogue_ratio", "scene_count", "production_notes"],
        "properties": {
          "episode_number": {"type": "integer", "minimum": 1},
          "title": {"type": "string", "minLength": 1},
          "script": {"type": "string", "minLength": 1},
          "word_count": {"type": "integer", "minimum": 1},
          "dialogue_ratio": {"type": "number", "minimum": 0, "maximum": 1},
          "scene_count": {"type": "integer", "minimum": 1},
          "golden_lines": {"type": "array", "items": {"type": "string"}},
          "format_check": {"type": "object"},
          "production_notes": {
            "type": "object",
            "required": ["tags", "complexity_score", "complexity_band", "high_cost_scenes", "lower_cost_alternatives"],
            "properties": {
              "tags": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
              "complexity_score": {"type": "integer", "minimum": 0},
              "complexity_band": {"enum": ["lean", "standard", "complex"]},
              "high_cost_scenes": {"type": "array", "items": {"type": "string"}},
              "lower_cost_alternatives": {"type": "array", "items": {"type": "string"}}
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}

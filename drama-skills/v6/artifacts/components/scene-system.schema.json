{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "drama-skills-v6://artifacts/components/scene-system",
  "type": "object",
  "required": ["episode", "segments", "information_gaps", "scenes"],
  "properties": {
    "episode": {"type": "integer", "minimum": 1},
    "segments": {
      "type": "array", "minItems": 4, "maxItems": 4,
      "items": {
        "type": "object", "required": ["kind", "ratio", "purpose"],
        "properties": {
          "kind": {"enum": ["hook", "situation", "escalation", "cliffhanger"]},
          "ratio": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
          "purpose": {"type": "string", "minLength": 4}
        }, "additionalProperties": false
      }
    },
    "information_gaps": {
      "type": "array",
      "items": {
        "type": "object", "required": ["id", "type", "secret", "knowers", "nonknowers", "planned_reveal_episode", "next_question"],
        "properties": {
          "id": {"type": "string", "pattern": "^info-[a-z0-9-]+$"},
          "type": {"enum": ["audience-knows", "character-knows", "mutual-knowledge-game"]},
          "secret": {"type": "string", "minLength": 4},
          "knowers": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "nonknowers": {"type": "array", "items": {"type": "string"}},
          "planned_reveal_episode": {"type": "integer", "minimum": 1},
          "next_question": {"type": "string", "minLength": 4}
        }, "additionalProperties": false
      }
    },
    "scenes": {"type": "array", "minItems": 1, "maxItems": 3, "items": {"$ref": "#/$defs/scene"}}
  },
  "$defs": {
    "dialogue": {
      "type": "object", "required": ["speaker", "text", "intent", "subtext", "power_before", "power_after", "information_point"],
      "properties": {
        "speaker": {"type": "string", "minLength": 1},
        "text": {"type": "string", "minLength": 1},
        "intent": {"enum": ["probe", "conceal", "attack", "defend", "exchange", "recruit", "refuse"]},
        "subtext": {"type": "string", "minLength": 2},
        "power_before": {"type": "integer", "minimum": -5, "maximum": 5},
        "power_after": {"type": "integer", "minimum": -5, "maximum": 5},
        "information_point": {"type": "string", "minLength": 2}
      }, "additionalProperties": false
    },
    "scene": {
      "type": "object", "required": ["id", "time", "space", "location", "goal", "obstacle", "risk", "value_before", "value_after", "actions", "dialogue", "next_scene_handoff"],
      "properties": {
        "id": {"type": "string", "pattern": "^scene-[0-9]+-[0-9]+$"},
        "time": {"enum": ["day", "night", "dawn", "dusk"]},
        "space": {"enum": ["interior", "exterior"]},
        "location": {"type": "string", "minLength": 1},
        "goal": {"type": "string", "minLength": 4},
        "obstacle": {"type": "string", "minLength": 4},
        "risk": {"type": "string", "minLength": 4},
        "value_before": {"type": "string", "minLength": 2},
        "value_after": {"type": "string", "minLength": 2},
        "actions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 2}},
        "dialogue": {"type": "array", "items": {"$ref": "#/$defs/dialogue"}},
        "next_scene_handoff": {"type": "string", "minLength": 2}
      }, "additionalProperties": false
    }
  },
  "additionalProperties": false
}

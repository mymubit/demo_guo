{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "drama-skills-v6://artifacts/components/production-package",
  "type": "object",
  "required": ["production_assessments", "budget_estimate", "release_check"],
  "properties": {
    "production_assessments": {"type": "array", "items": {"$ref": "#/$defs/assessment"}},
    "budget_estimate": {"$ref": "#/$defs/budget"},
    "release_check": {"$ref": "#/$defs/release"}
  },
  "$defs": {
    "alternative": {
      "type": "object", "required": ["changes", "preserved_dramatic_function", "preserved_core_turn"],
      "properties": {"changes": {"type": "array", "minItems": 1, "items": {"enum": ["space", "visible-action", "performer-count", "presentation"]}}, "preserved_dramatic_function": {"type": "string", "minLength": 1}, "preserved_core_turn": {"type": "string", "minLength": 1}},
      "additionalProperties": false
    },
    "assessment": {
      "type": "object", "required": ["episode", "scene_id", "resource_tags", "complexity", "alternatives"],
      "properties": {"episode": {"type": "integer", "minimum": 1}, "scene_id": {"type": "string"}, "resource_tags": {"type": "array", "uniqueItems": true, "items": {"enum": ["location-change", "night-or-exterior", "crowd", "action-hazard", "special-prop", "visual-effect", "minor", "animal"]}}, "complexity": {"enum": ["low", "medium", "high"]}, "alternatives": {"type": "array", "items": {"$ref": "#/$defs/alternative"}}},
      "allOf": [{"if": {"properties": {"complexity": {"const": "high"}}, "required": ["complexity"]}, "then": {"properties": {"alternatives": {"minItems": 1}}}}],
      "additionalProperties": false
    },
    "budget": {
      "type": "object", "required": ["mode", "resource_complexity", "band"],
      "properties": {"mode": {"enum": ["band", "amount"]}, "resource_complexity": {"enum": ["low", "medium", "high"]}, "band": {"enum": ["low", "medium", "high", "very-high"]}, "amount": {"type": "number", "minimum": 0}, "currency": {"type": "string"}, "region": {"type": "string"}, "price_version": {"type": "string"}, "excluded_items": {"type": "array", "items": {"type": "string"}}},
      "allOf": [{"if": {"properties": {"mode": {"const": "amount"}}, "required": ["mode"]}, "then": {"required": ["amount", "currency", "region", "price_version", "excluded_items"]}}],
      "additionalProperties": false
    },
    "release": {
      "type": "object", "required": ["target_platform", "policy_status", "policy_version", "ai_content_labeling", "filing_materials", "title_check", "rights_authorization", "quality_report", "compliance_report", "release_ready", "blockers"],
      "properties": {"target_platform": {"type": "string"}, "policy_status": {"enum": ["verified-current", "unverified", "expired"]}, "policy_version": {"type": "string"}, "ai_content_labeling": {"type": "boolean"}, "filing_materials": {"type": "boolean"}, "title_check": {"type": "boolean"}, "rights_authorization": {"type": "boolean"}, "quality_report": {"type": "boolean"}, "compliance_report": {"type": "boolean"}, "release_ready": {"type": "boolean"}, "blockers": {"type": "array", "items": {"type": "string"}}},
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}

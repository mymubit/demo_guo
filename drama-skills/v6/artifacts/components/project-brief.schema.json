{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "drama-skills-v6://artifacts/components/project-brief",
  "type": "object",
  "required": ["title", "entry_path", "combination_method", "forced_choice", "core_dramatic_action", "elevator_pitch", "genre_matrix", "rule_params", "synopsis", "audience_channel", "market_opportunity", "blockbuster_factors", "competitor_references", "differentiation_strategy", "first_episode_hook", "first_paywall_direction", "subject_sensitivity_precheck", "quantitative_parameter_source"],
  "properties": {
    "title": {"type": "string", "minLength": 1},
    "entry_path": {"enum": ["theme", "character", "space", "relationship", "tag-collision"]},
    "combination_method": {"enum": ["grafting", "time-space-displacement", "embodied-metaphor", "reversal-juxtaposition", "rule-inversion"]},
    "forced_choice": {"$ref": "#/$defs/forcedChoice"},
    "core_dramatic_action": {"type": "string", "minLength": 1},
    "elevator_pitch": {"$ref": "#/$defs/elevator"},
    "genre_matrix": {"type": "object", "required": ["emotion", "identity", "conflict", "world", "flavor_tags"], "properties": {"emotion": {"type": "string"}, "identity": {"type": "string"}, "conflict": {"type": "string"}, "world": {"type": "string"}, "flavor_tags": {"type": "array", "items": {"type": "string"}}}, "additionalProperties": false},
    "rule_params": {"type": "object", "required": ["reversal_density", "emotion_curve", "act_ratio", "hook_types"], "properties": {"reversal_density": {"type": "number", "minimum": 0, "maximum": 1}, "emotion_curve": {"type": "array", "minItems": 8, "maxItems": 8, "items": {"type": "number"}}, "act_ratio": {"type": "array", "minItems": 6, "maxItems": 6, "items": {"type": "number", "exclusiveMinimum": 0}}, "hook_types": {"type": "array", "minItems": 1, "items": {"type": "string"}}}, "additionalProperties": false},
    "synopsis": {"type": "string", "minLength": 1},
    "audience_channel": {"type": "string", "minLength": 1},
    "market_opportunity": {"type": "string", "minLength": 1},
    "blockbuster_factors": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "competitor_references": {"type": "array", "items": {"$ref": "#/$defs/competitor"}},
    "differentiation_strategy": {"type": "string", "minLength": 1},
    "first_episode_hook": {"type": "string", "minLength": 1},
    "first_paywall_direction": {"type": "string", "minLength": 1},
    "subject_sensitivity_precheck": {"type": "object", "required": ["risk_level", "evidence", "compliance_verdict"], "properties": {"risk_level": {"enum": ["low", "medium", "high"]}, "evidence": {"type": "array", "items": {"type": "string"}}, "compliance_verdict": {"const": null}}, "additionalProperties": false},
    "quantitative_parameter_source": {"const": "foundation/constraints/commercial-formulas.yaml"}
  },
  "$defs": {
    "forcedChoice": {"type": "object", "required": ["who", "situation", "pressure", "choice"], "properties": {"who": {"type": "string", "minLength": 1}, "situation": {"type": "string", "minLength": 1}, "pressure": {"type": "string", "minLength": 1}, "choice": {"type": "string", "minLength": 1}}, "additionalProperties": false},
    "elevator": {"type": "object", "required": ["protagonist_identity", "urgent_goal", "core_obstacle", "differentiating_mechanism", "without_proper_nouns"], "properties": {"protagonist_identity": {"type": "string", "minLength": 1}, "urgent_goal": {"type": "string", "minLength": 1}, "core_obstacle": {"type": "string", "minLength": 1}, "differentiating_mechanism": {"type": "string", "minLength": 1}, "without_proper_nouns": {"type": "string", "minLength": 1}}, "additionalProperties": false},
    "competitor": {"type": "object", "required": ["title", "inspiration", "avoidance"], "properties": {"title": {"type": "string"}, "inspiration": {"type": "string"}, "avoidance": {"type": "string", "minLength": 1}}, "additionalProperties": false}
  },
  "additionalProperties": false
}

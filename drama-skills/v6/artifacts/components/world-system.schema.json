{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "drama-skills-v6://artifacts/components/world-system",
  "type": "object",
  "required": ["setting_summary", "rules", "power_structure", "reveal_plan"],
  "properties": {
    "setting_summary": {"type": "string", "minLength": 10},
    "rules": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/worldRule"}},
    "power_structure": {"$ref": "#/$defs/powerStructure"},
    "reveal_plan": {"type": "array", "items": {"$ref": "#/$defs/reveal"}}
  },
  "$defs": {
    "change": {
      "type": "object",
      "required": ["dimension", "description"],
      "properties": {
        "dimension": {"enum": ["goal", "choice", "cost", "consequence", "resource"]},
        "description": {"type": "string", "minLength": 4}
      },
      "additionalProperties": false
    },
    "exception": {
      "type": "object",
      "required": ["source", "trigger", "cost"],
      "properties": {
        "source": {"type": "string", "minLength": 4},
        "trigger": {"type": "string", "minLength": 4},
        "cost": {"type": "string", "minLength": 4}
      },
      "additionalProperties": false
    },
    "worldRule": {
      "type": "object",
      "required": ["id", "name", "applies_to", "trigger_conditions", "changes", "violation_cost", "visible_expression", "authority", "exceptions"],
      "properties": {
        "id": {"type": "string", "pattern": "^world-rule-[a-z0-9-]+$"},
        "name": {"type": "string", "minLength": 2},
        "applies_to": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "trigger_conditions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 4}},
        "changes": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/change"}},
        "violation_cost": {"type": "string", "minLength": 4},
        "visible_expression": {"type": "string", "minLength": 4},
        "authority": {"type": "string", "minLength": 2},
        "exceptions": {"type": "array", "items": {"$ref": "#/$defs/exception"}}
      },
      "additionalProperties": false
    },
    "resource": {
      "type": "object",
      "required": ["id", "resource", "controller", "rule_maker", "cost_bearer", "main_conflict_pressure"],
      "properties": {
        "id": {"type": "string", "pattern": "^resource-[a-z0-9-]+$"},
        "resource": {"type": "string", "minLength": 2},
        "controller": {"type": "string", "minLength": 1},
        "rule_maker": {"type": "string", "minLength": 1},
        "cost_bearer": {"type": "string", "minLength": 1},
        "main_conflict_pressure": {"type": "string", "minLength": 4}
      },
      "additionalProperties": false
    },
    "loophole": {
      "type": "object",
      "required": ["id", "rule_id", "available_to", "condition", "cost"],
      "properties": {
        "id": {"type": "string", "pattern": "^loophole-[a-z0-9-]+$"},
        "rule_id": {"type": "string", "pattern": "^world-rule-[a-z0-9-]+$"},
        "available_to": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "condition": {"type": "string", "minLength": 4},
        "cost": {"type": "string", "minLength": 4}
      },
      "additionalProperties": false
    },
    "powerStructure": {
      "type": "object",
      "required": ["resources", "loopholes"],
      "properties": {
        "resources": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/resource"}},
        "loopholes": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/loophole"}}
      },
      "additionalProperties": false
    },
    "reveal": {
      "type": "object",
      "required": ["rule_id", "episode", "layer", "action", "consequence", "affected_choice"],
      "properties": {
        "rule_id": {"type": "string", "pattern": "^world-rule-[a-z0-9-]+$"},
        "episode": {"type": "integer", "minimum": 1},
        "layer": {"type": "string", "minLength": 1},
        "action": {"type": "string", "minLength": 4},
        "consequence": {"type": "string", "minLength": 4},
        "affected_choice": {"type": "string", "minLength": 4}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}

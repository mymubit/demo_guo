{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "drama-skills-v6://artifacts/episode-plan/2",
  "type": "object",
  "required": ["schema_version", "artifact_version", "based_on", "episodes"],
  "properties": {
    "schema_version": {"const": 2},
    "artifact_version": {"type": "integer", "minimum": 1},
    "source_call_id": {"type": "string", "minLength": 1},
    "based_on": {
      "type": "object",
      "required": ["story_bible"],
      "properties": {
        "story_bible": {"type": "integer", "minimum": 1},
        "episode_plan": {"type": ["integer", "null"], "minimum": 1}
      },
      "additionalProperties": false
    },
    "episodes": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/episodeCard"}
    }
  },
  "$defs": {
    "emotionNode": {
      "type": "object",
      "required": ["event", "emotion", "intensity", "character_action"],
      "properties": {
        "event": {"type": "string", "minLength": 4},
        "emotion": {"type": "string", "minLength": 1},
        "intensity": {"type": "integer", "minimum": 1, "maximum": 10},
        "character_action": {"type": "string", "minLength": 2}
      },
      "additionalProperties": false
    },
    "foreshadowEntry": {
      "type": "object",
      "required": ["clue", "setup_episode", "payoff_episode", "status"],
      "properties": {
        "clue": {"type": "string", "minLength": 2},
        "setup_episode": {"type": "integer", "minimum": 1},
        "payoff_episode": {"type": "integer", "minimum": 1},
        "status": {"enum": ["planned", "setup", "paid_off", "overdue"]}
      },
      "additionalProperties": false
    },
    "episodeCard": {
      "type": "object",
      "required": ["episode", "title", "core_event", "goal_conflict", "characters", "opening_hook", "ending_hook", "hook_grade", "satisfaction_points", "reversal", "emotion_nodes", "paywall", "foreshadowing", "rhythm_tag"],
      "properties": {
        "episode": {"type": "integer", "minimum": 1},
        "title": {"type": "string", "minLength": 2},
        "core_event": {"type": "string", "minLength": 10},
        "goal_conflict": {"type": "string", "minLength": 8},
        "characters": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "opening_hook": {"type": "string", "minLength": 4},
        "ending_hook": {"type": "string", "minLength": 4},
        "hook_grade": {"enum": ["S", "A", "B", "C"]},
        "satisfaction_points": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 2}},
        "reversal": {"type": ["string", "null"], "minLength": 4},
        "emotion_nodes": {
          "type": "object",
          "required": ["EV", "ET", "TP"],
          "properties": {
            "EV": {"$ref": "#/$defs/emotionNode"},
            "ET": {"$ref": "#/$defs/emotionNode"},
            "TP": {"$ref": "#/$defs/emotionNode"}
          },
          "additionalProperties": false
        },
        "paywall": {
          "type": ["object", "null"],
          "properties": {
            "card_type": {"enum": ["emotion", "suspense", "satisfaction"]},
            "promise": {"type": "string", "minLength": 4},
            "payoff_episode": {"type": "integer", "minimum": 1}
          },
          "required": ["card_type", "promise", "payoff_episode"],
          "additionalProperties": false
        },
        "foreshadowing": {"type": "array", "items": {"$ref": "#/$defs/foreshadowEntry"}},
        "rhythm_tag": {"type": "string", "pattern": "^(loose|medium|tight)-(light|medium|heavy)$"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}

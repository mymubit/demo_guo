{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "drama-skills-v6://contracts/operation",
  "type": "object",
  "required": ["id", "version", "persona", "user_inputs", "system_inputs", "reads", "writes", "capabilities", "stages", "transaction"],
  "properties": {
    "id": {"type": "string", "pattern": "^operation\\.[a-z0-9-]+$"},
    "version": {"type": "integer", "minimum": 1},
    "persona": {"type": "string", "pattern": "^persona\\.[a-z0-9-]+$"},
    "user_inputs": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
    "system_inputs": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
    "reads": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
    "writes": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
    "scope": {"type": "object"},
    "required_params": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "capabilities": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
    "constraints": {
      "type": "object",
      "properties": {
        "user_levels": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "readonly": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "write_scope": {"type": "string"}
      },
      "additionalProperties": false
    },
    "validation": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
    "outputs": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
    "stages": {
      "type": "array",
      "const": ["command", "plan", "execution_pack", "candidate", "validation", "change_set", "impact_plan", "commit"]
    },
    "transaction": {
      "type": "object",
      "required": ["plan_required", "candidate_only", "validation_required", "atomic_commit"],
      "properties": {
        "plan_required": {"const": true},
        "candidate_only": {"const": true},
        "validation_required": {"const": true},
        "atomic_commit": {"const": true}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}

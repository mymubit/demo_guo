{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "drama-skills-v6://contracts/advisory",
  "type": "object",
  "required": ["id", "version", "category", "precedence", "patterns"],
  "properties": {
    "id": {"type": "string", "pattern": "^advisory\\.[a-z0-9-]+$"},
    "version": {"type": "integer", "minimum": 1},
    "category": {"type": "string"},
    "precedence": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
    "patterns": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "when", "suggestions", "source_refs"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
          "when": {"type": "object"},
          "suggestions": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "avoid": {"type": "array", "items": {"type": "string"}},
          "source_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
